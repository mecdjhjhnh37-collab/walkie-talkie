<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محادثة صوتية خاصة | Voice Room</title>
    <!-- Tailwind CSS للتصميم -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Socket.io & QRCode CDN -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        .ptt-btn:active, .ptt-active {
            transform: scale(0.95);
            box-shadow: 0 0 25px rgba(239, 68, 68, 0.8);
        }
    </style>
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col items-center justify-center p-4">

    <div class="w-full max-w-md bg-slate-800 p-6 rounded-2xl shadow-xl border border-slate-700 text-center">
        <h1 class="text-2xl font-bold mb-2">🎙️ غرف الصوت الخاصة</h1>
        <p class="text-slate-400 text-sm mb-6">اتصال صوتي مباشر مشفر بتقنية WebRTC</p>

        <!-- حالة الغرفة والتوصيل -->
        <div id="status" class="mb-4 text-amber-400 text-sm font-medium">جاري إعداد الغرفة...</div>

        <!-- معلومات الغرفة و QR Code -->
        <div id="room-info" class="hidden mb-6 bg-slate-900 p-4 rounded-xl border border-slate-700">
            <p class="text-xs text-slate-400 mb-2">امسح الكود للانضمام من الهاتف:</p>
            <div id="qrcode" class="flex justify-center p-2 bg-white rounded-lg w-max mx-auto mb-3"></div>
            <p class="text-xs text-slate-300 break-all select-all font-mono bg-slate-800 p-2 rounded" id="room-link"></p>
        </div>

        <!-- زر Push-to-Talk -->
        <div class="my-8">
            <button id="ptt-btn" disabled 
                    class="ptt-btn w-36 h-36 rounded-full bg-slate-700 text-white font-bold text-lg flex flex-col items-center justify-center mx-auto transition-all duration-200 border-4 border-slate-600 disabled:opacity-40 disabled:cursor-not-allowed select-none">
                <span class="text-3xl mb-1">🎙️</span>
                <span id="ptt-label">اضغط للتحدث</span>
            </button>
            <p class="text-xs text-slate-500 mt-3">اضغط باستمرار على الزر (أو زر Space) للتحدث</p>
        </div>

        <!-- عنصر الصوت المخفي للمستقبل -->
        <audio id="remote-audio" autoplay></audio>
    </div>

    <script>
        const socket = io();
        let localStream;
        let peerConnection;
        let audioTrack;

        const pttBtn = document.getElementById('ptt-btn');
        const pttLabel = document.getElementById('ptt-label');
        const statusDiv = document.getElementById('status');
        const roomInfo = document.getElementById('room-info');
        const qrcodeDiv = document.getElementById('qrcode');
        const roomLink = document.getElementById('room-link');
        const remoteAudio = document.getElementById('remote-audio');

        // خوادم STUN مجانية لاستكشاف مسار الاتصال عبر الشبكات
        const rtcConfig = {
            iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
        };

        // الحصول على رمز الغرفة من الرابط أو إنشاؤه
        const urlParams = new URLSearchParams(window.location.search);
        let roomId = urlParams.get('room');
        if (!roomId) {
            roomId = Math.random().toString(36).substring(2, 8);
            window.history.replaceState({}, '', `?room=${roomId}`);
        }

        // عرض تفاصيل الغرفة و QR Code
        const fullUrl = window.location.href;
        roomLink.innerText = fullUrl;
        new QRCode(qrcodeDiv, { text: fullUrl, width: 128, height: 128 });
        roomInfo.classList.remove('hidden');

        // إعداد الميكروفون
        async function initAudio() {
            try {
                localStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                audioTrack = localStream.getAudioTracks()[0];
                audioTrack.enabled = false; // مكتوم حتى يتم الضغط على الزر

                socket.emit('join-room', roomId);
                statusDiv.innerText = "بانتظار انضمام الطرف الثاني...";
            } catch (err) {
                statusDiv.innerText = "❌ يرجى السماح بالوصول للميكروفون";
                console.error(err);
            }
        }

        // إنشاء اتصال WebRTC Peer Connection
        function createPeerConnection() {
            peerConnection = new RTCPeerConnection(rtcConfig);

            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
            });

            peerConnection.ontrack = (event) => {
                remoteAudio.srcObject = event.streams[0];
            };

            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    socket.emit('signal', { candidate: event.candidate });
                }
            };
        }

        // أحداث Socket.io
        socket.on('room-full', () => {
            statusDiv.innerText = "⚠️ الغرفة مكتملة (تتسع لشخصين فقط)";
        });

        socket.on('user-joined', async () => {
            statusDiv.innerText = "🟢 متصل بالأطراف الآخر";
            pttBtn.disabled = false;
            createPeerConnection();

            const offer = await peerConnection.createOffer();
            await peerConnection.setLocalDescription(offer);
            socket.emit('signal', { offer });
        });

        socket.on('signal', async (data) => {
            if (!peerConnection) createPeerConnection();

            if (data.offer) {
                await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));
                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);
                socket.emit('signal', { answer });
                statusDiv.innerText = "🟢 متصل بالطرف الآخر";
                pttBtn.disabled = false;
            } else if (data.answer) {
                await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
            } else if (data.candidate) {
                await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
            }
        });

        socket.on('user-left', () => {
            statusDiv.innerText = "🔴 غادر الطرف الآخر الغرفة";
            pttBtn.disabled = true;
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
            }
        });

        // آليات Push-To-Talk (اللمس، الماوس، ولوحة المفاتيح)
        function startTalking() {
            if (audioTrack && pttBtn.disabled === false) {
                audioTrack.enabled = true;
                pttBtn.classList.add('bg-red-600', 'border-red-400', 'ptt-active');
                pttBtn.classList.remove('bg-slate-700', 'border-slate-600');
                pttLabel.innerText = "تحدث الآن...";
            }
        }

        function stopTalking() {
            if (audioTrack) {
                audioTrack.enabled = false;
                pttBtn.classList.remove('bg-red-600', 'border-red-400', 'ptt-active');
                pttBtn.classList.add('bg-slate-700', 'border-slate-600');
                pttLabel.innerText = "اضغط للتحدث";
            }
        }

        // أحداث الفأرة واللمس
        pttBtn.addEventListener('mousedown', startTalking);
        pttBtn.addEventListener('mouseup', stopTalking);
        pttBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startTalking(); });
        pttBtn.addEventListener('touchend', (e) => { e.preventDefault(); stopTalking(); });

        // التحدث باستخدام زر المسافة (Spacebar)
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space' && !e.repeat) startTalking();
        });
        window.addEventListener('keyup', (e) => {
            if (e.code === 'Space') stopTalking();
        });

        // تشغيل التطبيق عند التحميل
        window.onload = initAudio;
    </script>
</body>
</html>
